# Salin fail ni jadi .env (untuk PC) atau masukkan dalam Vercel → Settings → Environment Variables.

# Database Postgres. Dev: `npx prisma dev`. Production: Neon (pooled URL & direct URL).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=1"
DATABASE_URL_UNPOOLED="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=1"

# CHIP (chip-in.asia) — kosongkan untuk mod test (development sahaja).
# Key & Brand ID: portal CHIP → Developers. Key test dan key live guna alamat API yang sama.
CHIP_SECRET_KEY=""
CHIP_BRAND_ID=""

# J&T Express — kosongkan kalau tak guna (admin isi no. tracking sendiri).
# Semua nilai ni diberi oleh J&T untuk akaun VIP (minta "API integration" dari J&T).
JNT_USERNAME=""        # nama akaun API (platform)
JNT_API_KEY=""         # api key akaun API
JNT_CUSTOMER_CODE=""   # VIP code / customer code
JNT_PASSWORD=""        # password API untuk customer code
JNT_SIGN_KEY=""        # sign key untuk tandatangan request
JNT_SERVICE_TYPE="1"   # 1 = J&T datang pickup, 6 = hantar sendiri ke kaunter (drop-off)
# Alamat pengirim yang dicetak pada label
JNT_SENDER_NAME=""
JNT_SENDER_PHONE=""
JNT_SENDER_ADDRESS=""
JNT_SENDER_POSTCODE=""

# Alamat website (untuk return/callback URL CHIP)
APP_URL="http://localhost:3000"

# Login page /admin
ADMIN_PASSWORD=""
# Rahsia untuk sign cookie admin, sekurang-kurangnya 32 aksara rawak
ADMIN_SESSION_SECRET=""
