# Salin fail ni jadi .env (untuk PC) atau masukkan dalam Vercel → Settings → Environment Variables.

# Database Postgres. Dev: `npx prisma dev`. Production: Neon (pooled URL & direct URL).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=1"
DATABASE_URL_UNPOOLED="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=1"

# ToyyibPay — kosongkan untuk mod test (development sahaja).
# Sandbox: https://dev.toyyibpay.com  |  Live: https://toyyibpay.com
TOYYIBPAY_BASE_URL="https://dev.toyyibpay.com"
TOYYIBPAY_SECRET_KEY=""
TOYYIBPAY_CATEGORY_CODE=""

# Alamat website (untuk return/callback URL ToyyibPay)
APP_URL="http://localhost:3000"

# Email "baju dah dipos" (https://resend.com). Kosongkan = tiada email.
# EMAIL_FROM mesti guna domain yang dah verify dalam Resend.
RESEND_API_KEY=""
EMAIL_FROM="Wan Kaadiaq <order@domain-customer.com>"
EMAIL_REPLY_TO=""

# EasyParcel (https://easyparcel.com/my) — tempah kurier & cetak label dari /admin.
# Demo: https://demo.connect.easyparcel.my  |  Live: https://connect.easyparcel.my
EASYPARCEL_BASE_URL="https://demo.connect.easyparcel.my"
EASYPARCEL_API_KEY=""
# Alamat pengirim (kedai). SHIP_FROM_STATE ikut nama negeri dalam borang, cth "Selangor", "W.P. Kuala Lumpur".
SHIP_FROM_NAME="Wan Kaadiaq"
SHIP_FROM_PHONE=""
SHIP_FROM_ADDR1=""
SHIP_FROM_ADDR2=""
SHIP_FROM_CITY=""
SHIP_FROM_POSTCODE=""
SHIP_FROM_STATE="Selangor"
# Berat sehelai baju (kg) termasuk bungkusan
SHIP_WEIGHT_KG_PER_ITEM="0.3"

# Login page /admin
ADMIN_PASSWORD=""
# Rahsia untuk sign cookie admin, sekurang-kurangnya 32 aksara rawak
ADMIN_SESSION_SECRET=""
