# Salin fail ni jadi .env (untuk PC) atau masukkan dalam Vercel → Settings → Environment Variables.

# Database Postgres. Dev: `npx prisma dev`. Production: Neon (pooled URL & direct URL).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=1"
DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=1"

# ToyyibPay — kosongkan untuk mod test (development sahaja).
# Sandbox: https://dev.toyyibpay.com  |  Live: https://toyyibpay.com
TOYYIBPAY_BASE_URL="https://dev.toyyibpay.com"
TOYYIBPAY_SECRET_KEY=""
TOYYIBPAY_CATEGORY_CODE=""

# Alamat website (untuk return/callback URL ToyyibPay)
APP_URL="http://localhost:3000"

# Login page /admin
ADMIN_PASSWORD=""
# Rahsia untuk sign cookie admin, sekurang-kurangnya 32 aksara rawak
ADMIN_SESSION_SECRET=""
