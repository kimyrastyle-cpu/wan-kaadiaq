generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (Neon: URL dengan -pooler)
  directUrl = env("DIRECT_URL") // direct, untuk migration
}

// ---------- Kedai baju ----------

model Order {
  id             String    @id @default(cuid())
  firstName      String
  lastName       String
  customerEmail  String
  customerPhone  String
  company        String?
  address1       String
  address2       String? // apartment, suite, dll.
  postcode       String
  city           String
  state          String
  country        String    @default("Malaysia")
  size           String // S, M, L, XL, XXL
  quantity       Int
  amountCents    Int // jumlah dalam sen (RM 59.00 = 5900)
  status         String    @default("PENDING") // PENDING, PAID, FAILED, SHIPPED
  billCode       String?   @unique // kod bil dari ToyyibPay
  trackingNumber String? // no. tracking kurier bila dah pos
  shippedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ---------- Booking barbershop ----------

model Barber {
  id       String    @id @default(cuid())
  name     String
  active   Boolean   @default(true)
  bookings Booking[]
}

model Service {
  id              String    @id @default(cuid())
  name            String
  durationMinutes Int
  priceCents      Int
  active          Boolean   @default(true)
  bookings        Booking[]
}

model Booking {
  id            String   @id @default(cuid())
  customerName  String
  customerPhone String
  barberId      String
  serviceId     String
  startsAt      DateTime
  endsAt        DateTime
  status        String   @default("CONFIRMED") // CONFIRMED, CANCELLED, DONE
  createdAt     DateTime @default(now())
  barber        Barber   @relation(fields: [barberId], references: [id])
  service       Service  @relation(fields: [serviceId], references: [id])

  @@index([barberId, startsAt])
}
